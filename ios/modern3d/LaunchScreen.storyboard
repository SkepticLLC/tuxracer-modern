<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="landscape" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23503"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" clipsSubviews="YES" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="852" height="393"/>
                        <viewLayoutGuide key="safeArea" id="launch-safe"/>
                        <!-- One image, full width, pinned to the top. Its aspect ratio
                             follows the source artwork; extra-wide iPhones crop
                             only the lower snow, never the TUX logo. -->
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="SplashLandscape" translatesAutoresizingMaskIntoConstraints="NO" id="launch-art">
                                <rect key="frame" x="0.0" y="0.0" width="852" height="480"/>
                                <constraints>
                                    <constraint firstAttribute="height" secondItem="launch-art" secondAttribute="width" multiplier="941:1672" id="launch-image-ratio"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.05" green="0.31" blue="0.59" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-art" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="launch-left"/>
                            <constraint firstItem="launch-art" firstAttribute="trailing" secondItem="launch-root" secondAttribute="trailing" id="launch-right"/>
                            <constraint firstItem="launch-art" firstAttribute="top" secondItem="launch-root" secondAttribute="top" id="launch-top"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="SplashLandscape" width="1672" height="941"/>
    </resources>
</document>
